.points {
  padding: 20rpx 0 48rpx;
}

.hero {
  margin: 4rpx 32rpx 0;
  padding: 40rpx 32rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(150deg, #33513f 0%, #22362c 100%);
  position: relative;
  overflow: hidden;
}

.hero::after {
  content: "";
  position: absolute;
  right: -70rpx;
  bottom: -110rpx;
  width: 300rpx;
  height: 300rpx;
  border: 1rpx solid rgba(248, 244, 236, 0.1);
  border-radius: 50%;
}

.hero-label {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: rgba(248, 244, 236, 0.55);
}

.hero-num {
  margin-top: 8rpx;
  font-family: "DIN Alternate", "Helvetica Neue", sans-serif;
  font-size: 96rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #f8f4ec;
}

.hero-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.hitem {
  display: flex;
  align-items: baseline;
}

.hn {
  font-family: "DIN Alternate", sans-serif;
  font-size: 28rpx;
  color: #f0d68a;
}

.hl {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: rgba(248, 244, 236, 0.5);
}

.hdiv {
  width: 1rpx;
  height: 22rpx;
  margin: 0 24rpx;
  background: rgba(248, 244, 236, 0.22);
}

.rules {
  margin: 24rpx 32rpx 0;
  padding: 28rpx 32rpx 20rpx;
}

.rules-title {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

.rrow {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f4ecde;
}

.rrow:last-child {
  border-bottom: 0;
}

.rk {
  width: 110rpx;
  flex: 0 0 110rpx;
  font-size: 24rpx;
  color: #b65b3c;
  letter-spacing: 1rpx;
}

.rv {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.6;
  color: #5c554a;
}

.logs {
  margin: 24rpx 32rpx 0;
  padding: 28rpx 32rpx 16rpx;
}

.logs-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 8rpx;
}

.lh {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.lh-sub {
  font-size: 22rpx;
  color: #84796a;
}

.lrow {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f4ecde;
}

.lrow:last-child {
  border-bottom: 0;
}

.lleft {
  flex: 1;
  min-width: 0;
}

.ltext {
  font-size: 28rpx;
  color: #3a342c;
}

.ltime {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #84796a;
}

.ldelta {
  font-family: "DIN Alternate", sans-serif;
  font-size: 32rpx;
  font-weight: 700;
  margin-left: 16rpx;
}

.ldelta.up {
  color: #2e4a3f;
}

.ldelta.down {
  color: #7a7264;
}

.lend {
  padding: 32rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #84796a;
}

.tip {
  margin-top: 28rpx;
  text-align: center;
  font-size: 22rpx;
  color: #84796a;
}
