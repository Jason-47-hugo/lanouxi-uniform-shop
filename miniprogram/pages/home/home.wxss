.nav {
  position: relative;
  z-index: 10;
}

.nav-inner {
  height: 96rpx;
  /* 右边留出微信胶囊（约 87px ≈ 174rpx）的位置，否则「全部校服」会被胶囊压住 */
  padding: 0 200rpx 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  display: flex;
  align-items: baseline;
}

.brand-name {
  font-size: 46rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  color: #2e4a3f;
  line-height: 1;
}

.brand-sub {
  margin-left: 16rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: #736b5e;
}

.nav-pill {
  display: flex;
  align-items: center;
  height: 60rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e3d8c7;
  background: rgba(255, 253, 249, 0.7);
  font-size: 26rpx;
  color: #6f675b;
  letter-spacing: 1rpx;
}

.nav-arrow {
  margin-left: 8rpx;
  font-size: 28rpx;
  color: #7a7264;
}

.hero {
  position: relative;
  margin: 8rpx 32rpx 0;
  height: 460rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: #f2e9da;
}

.hero-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 图片左侧压一层柔和渐变，保证文字任何时候都读得清；
   底部再压一层暖色，让这张卡片和下面的奶油底色接得住 */
.hero-veil {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 64%;
  background: linear-gradient(90deg, rgba(248, 242, 231, 0.95) 0%, rgba(248, 242, 231, 0.74) 58%, rgba(248, 242, 231, 0) 100%);
}

.hero-veil::after {
  content: "";
  position: absolute;
  left: 0;
  right: -60%;
  bottom: 0;
  height: 96rpx;
  background: linear-gradient(0deg, rgba(247, 243, 236, 0.9) 0%, rgba(247, 243, 236, 0) 100%);
}

.hero-text {
  position: absolute;
  left: 40rpx;
  top: 46rpx;
  width: 380rpx;
}

.hero-eyebrow {
  font-size: 24rpx;
  letter-spacing: 3rpx;
  color: #8a7a62;
  margin-bottom: 20rpx;
}

.hero-title {
  font-size: 46rpx;
  font-weight: 600;
  line-height: 1.45;
  letter-spacing: 2rpx;
  color: #26364a;
}

.hero-sub {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #6e665b;
  letter-spacing: 1rpx;
}

.hero-btn {
  display: inline-flex;
  align-items: center;
  height: 66rpx;
  margin-top: 28rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #b65b3c;
  color: #fff8ee;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  box-shadow: 0 10rpx 24rpx rgba(182, 91, 60, 0.24);
}

.hero-btn:active {
  opacity: 0.85;
}

.arrow {
  margin-left: 12rpx;
}

.service {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 28rpx 32rpx 0;
  font-size: 24rpx;
  color: #7d7365;
  letter-spacing: 1rpx;
}

.service-item {
  white-space: nowrap;
}

.service-line {
  margin: 0 16rpx;
  color: #cbbda6;
}

/* 四个入口：不用圆圈图标，用方形「字牌」更像店里的小标签 */
.entries {
  display: flex;
  margin: 32rpx 32rpx 0;
}

.entry {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 20rpx;
  margin: 0 8rpx;
  border-radius: 24rpx;
  background: #fffdf9;
  border: 1rpx solid #efe6d8;
  box-shadow: 0 10rpx 26rpx rgba(80, 60, 40, 0.05);
}

.entry:active {
  background: #f8f1e5;
}

.entry-mark {
  width: 62rpx;
  height: 62rpx;
  border-radius: 16rpx;
  background: #f3ece0;
  color: #2e4a3f;
  font-size: 32rpx;
  line-height: 62rpx;
  text-align: center;
  letter-spacing: 0;
}

.entry-label {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #3a342c;
  letter-spacing: 1rpx;
}

.entry-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #7d7365;
}

.hscroll {
  width: 100%;
  margin-top: 4rpx;
}

.hscroll-inner {
  display: flex;
  padding: 0 32rpx 12rpx;
}

.fcard {
  flex: 0 0 300rpx;
  width: 300rpx;
  margin-right: 20rpx;
}

.fcard:last-child {
  margin-right: 0;
}

/* 按学校：一张卡片里放「学段 tab + 名单」，像店里的目录 */
.school-card {
  margin: 0 32rpx;
  padding: 8rpx 0 4rpx;
  border-radius: 24rpx;
  background: #fffdf9;
  border: 1rpx solid #efe6d8;
  overflow: hidden;
}

.stage-tabs {
  display: flex;
  padding: 20rpx 32rpx 16rpx;
}

.stab {
  position: relative;
  margin-right: 40rpx;
  padding-bottom: 8rpx;
  font-size: 28rpx;
  color: #736b5e;
  letter-spacing: 1rpx;
}

.stab.on {
  color: #26221d;
  font-weight: 600;
}

.stab.on::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 28rpx;
  height: 4rpx;
  margin-left: -14rpx;
  border-radius: 4rpx;
  background: #2e4a3f;
}

.schools {
  padding: 4rpx 0;
}

.sch {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
}

.sch:active {
  background: #faf5ec;
}

.sch + .sch {
  border-top: 1rpx solid #f3ebdd;
}

.sch-body {
  flex: 1;
  min-width: 0;
}

.sch-name {
  font-size: 28rpx;
  color: #2e4a3f;
  letter-spacing: 1rpx;
}

.sch-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #7d7365;
  letter-spacing: 1rpx;
}

.sch-arrow {
  margin-left: 16rpx;
  font-size: 30rpx;
  color: #a89d8c;
  line-height: 1;
}

.sch-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0 20rpx;
  border-top: 1rpx solid #f3ebdd;
  font-size: 24rpx;
  color: #736b5e;
  letter-spacing: 1rpx;
}

.sch-more-arrow {
  margin-left: 12rpx;
  color: #2e4a3f;
}

.invite {
  margin: 8rpx 20rpx 20rpx;
  padding: 20rpx 32rpx;
  border-radius: 16rpx;
  border: 1rpx dashed #ddcfba;
  background: #fbf7f0;
  text-align: center;
}

.invite-text {
  font-size: 24rpx;
  color: #6f675b;
  line-height: 1.6;
}

.invite-btn {
  display: inline-block;
  margin-top: 16rpx;
  padding: 0 32rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 999rpx;
  background: #2e4a3f;
  color: #f8f4ec;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.points-card {
  position: relative;
  margin: 48rpx 32rpx 0;
  padding: 40rpx 32rpx 32rpx;
  border-radius: 32rpx;
  background: #2e4a3f;
  overflow: hidden;
  color: #f3eee2;
}

.ring {
  position: absolute;
  border-radius: 50%;
  border: 1rpx solid rgba(247, 243, 236, 0.14);
}

.ring-a {
  width: 300rpx;
  height: 300rpx;
  right: -110rpx;
  top: -130rpx;
}

.ring-b {
  width: 180rpx;
  height: 180rpx;
  right: 40rpx;
  bottom: -110rpx;
}

.pc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pc-title {
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.pc-badge {
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(247, 243, 236, 0.35);
  font-size: 24rpx;
  color: #e9dfcc;
}

.pc-line {
  margin-top: 24rpx;
  font-size: 32rpx;
  letter-spacing: 1rpx;
}

.pc-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(247, 243, 236, 0.66);
}

.pc-link {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #e4c97e;
  letter-spacing: 1rpx;
}

.store-card {
  padding: 32rpx;
}

/* 装饰性引号：不写死高度，用负外边距把多余的字形空间吃掉，
   写死 height 会让字形被裁掉（审计脚本报 H quote 48>28） */
.quote {
  font-size: 96rpx;
  line-height: 1;
  margin-bottom: -8rpx;
  color: #c9a227;
}

.quote-text {
  font-size: 34rpx;
  line-height: 1.8;
  color: #3a342c;
  letter-spacing: 1rpx;
}

.quote-by {
  margin-top: 16rpx;
  text-align: right;
  font-size: 24rpx;
  color: #736b5e;
}

.store-line {
  margin: 28rpx 0 8rpx;
}

.store-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
}

.store-label {
  width: 84rpx;
  flex: 0 0 84rpx;
  font-size: 26rpx;
  color: #736b5e;
  line-height: 1.6;
}

.store-val {
  flex: 1;
  font-size: 26rpx;
  color: #4a4236;
  line-height: 1.6;
}

.store-acts {
  display: flex;
  margin-top: 24rpx;
}

.store-act {
  flex: 1;
  height: 76rpx;
  margin-right: 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid #d9cebd;
  font-size: 26rpx;
  color: #2e4a3f;
  text-align: center;
  line-height: 74rpx;
  letter-spacing: 1rpx;
}

.store-act:last-child {
  margin-right: 0;
}

.store-act:active {
  background: #f5efe3;
}

.footer {
  padding: 72rpx 0 40rpx;
  text-align: center;
}

.footer-name {
  font-size: 32rpx;
  letter-spacing: 10rpx;
  color: #736b5e;
  padding-left: 12rpx;
}

.footer-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  letter-spacing: 3rpx;
  color: #84796a;
}
