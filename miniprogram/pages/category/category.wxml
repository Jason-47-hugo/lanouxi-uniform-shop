<view class="page">
  <view class="head">
    <view class="search">
      <view class="search-icon"></view>
      <input
        value="{{keyword}}"
        bindinput="onSearch"
        placeholder="搜学校、款式，比如「市一中」"
        placeholder-class="placeholder"
        confirm-type="search"
      />
      <view class="search-clear" wx:if="{{keyword}}" bindtap="clearSearch">×</view>
    </view>
  </view>

  <view class="filters">
    <picker mode="selector" range="{{schoolNames}}" value="{{schoolIndex}}" bindchange="onSchoolPick">
      <view class="fp {{schoolIndex > 0 ? 'on' : ''}}">
        <text class="fp-label">{{schoolLabel}}</text>
        <text class="fp-caret">▾</text>
      </view>
    </picker>
    <picker mode="selector" range="{{stageNames}}" value="{{stageIndex}}" bindchange="onStagePick">
      <view class="fp {{stageIndex > 0 ? 'on' : ''}}">
        <text class="fp-label">{{stageLabel}}</text>
        <text class="fp-caret">▾</text>
      </view>
    </picker>
    <view class="fp {{sort === 'price' ? 'on' : ''}}" bindtap="toggleSort">
      <text class="fp-label">{{sort === 'price' ? '价格从低到高' : '综合排序'}}</text>
    </view>
  </view>

  <scroll-view class="cats" scroll-x="{{true}}" show-scrollbar="{{false}}">
    <view class="cats-inner">
      <view
        class="chip {{category === item ? 'on' : ''}}"
        wx:for="{{categories}}"
        wx:key="*this"
        data-cat="{{item}}"
        bindtap="onCategory"
      >{{item}}</view>
    </view>
  </scroll-view>

  <view class="count-row">
    <text class="count">共 {{count}} 款</text>
    <text class="count-tip" wx:if="{{filtered}}" bindtap="reset">清空筛选 ×</text>
    <text class="count-tip" wx:else>校服按学校分版型，不确定就问店长</text>
  </view>

  <view class="grid" wx:if="{{list.length}}">
    <view class="gitem" wx:for="{{list}}" wx:key="id">
      <product-card item="{{item}}" />
    </view>
  </view>

  <view class="empty" wx:else>
    <view class="empty-mark">空</view>
    <view class="empty-text">这个组合暂时没有货</view>
    <view class="empty-sub">换个学校或品类看看，也可以直接问店长</view>
    <view class="btn btn-ghost btn-sm reset-btn" bindtap="reset">清空筛选</view>
  </view>
</view>
