.order {
  padding-bottom: 128rpx;
}

.status {
  position: relative;
  padding: 40rpx 32rpx 32rpx;
  background: #2e4a3f;
  overflow: hidden;
}

.status.is-off {
  background: #6f6a60;
}

.st-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.st-main {
  flex: 1;
}

.st-text {
  font-size: 46rpx;
  color: #f8f4ec;
  letter-spacing: 3rpx;
}

.st-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(248, 244, 236, 0.72);
}

.st-mark {
  width: 78rpx;
  height: 78rpx;
  margin-left: 20rpx;
  border: 1rpx solid rgba(248, 244, 236, 0.4);
  border-radius: 50%;
  color: rgba(248, 244, 236, 0.85);
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 34rpx;
  line-height: 78rpx;
  text-align: center;
}

.progress {
  display: flex;
  margin-top: 32rpx;
}

.p-step {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.p-line {
  position: absolute;
  top: 9rpx;
  left: 50%;
  width: 100%;
  height: 2rpx;
  background: rgba(248, 244, 236, 0.22);
}

.p-line.on {
  background: rgba(248, 244, 236, 0.85);
}

.p-dot {
  position: relative;
  z-index: 1;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: rgba(248, 244, 236, 0.25);
  border: 2rpx solid transparent;
}

.p-step.done .p-dot {
  background: #f8f4ec;
}

.p-step.now .p-dot {
  background: #c9a227;
  box-shadow: 0 0 0 6rpx rgba(201, 162, 39, 0.24);
}

.p-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(248, 244, 236, 0.5);
}

.p-step.done .p-label {
  color: rgba(248, 244, 236, 0.85);
}

.p-step.now .p-label {
  color: #f0d68a;
}

.block {
  margin: 20rpx 32rpx 0;
  padding: 28rpx 32rpx;
}

.block-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.bh-title {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.bh-sub {
  font-size: 24rpx;
  color: #7a7264;
}

.addr-name {
  font-size: 30rpx;
  color: #26221d;
  padding-top: 8rpx;
}

.addr-phone {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #6f675b;
}

.addr-detail {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #5c554a;
  line-height: 1.6;
}

.addr-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #736b5e;
}

.track {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  background: #f6f0e4;
  font-size: 24rpx;
  color: #8a6a4f;
}

.oitem {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.oimg {
  width: 104rpx;
  height: 104rpx;
  flex: 0 0 104rpx;
  border-radius: 8rpx;
  background: #f3ece0;
  margin-right: 20rpx;
}

.obody {
  flex: 1;
  min-width: 0;
}

.oname {
  font-size: 28rpx;
  color: #26221d;
}

.ospec {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #736b5e;
}

.oright {
  text-align: right;
  margin-left: 16rpx;
}

.oprice {
  font-size: 28rpx;
}

.oqty {
  font-size: 24rpx;
  color: #736b5e;
}

.srow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.slabel {
  font-size: 26rpx;
  color: #6f675b;
}

.sval {
  font-size: 26rpx;
  color: #26221d;
}

.sval.minus {
  color: #2e4a3f;
}

.sval.muted {
  color: #a0603f;
}

.srow.total {
  padding-top: 12rpx;
}

.slabel.strong {
  font-size: 28rpx;
  font-weight: 600;
  color: #26221d;
}

.total .price {
  font-size: 42rpx;
}

.total .cur {
  font-size: 24rpx;
}

.irow {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.ilabel {
  width: 130rpx;
  flex: 0 0 130rpx;
  font-size: 24rpx;
  color: #736b5e;
}

.ival {
  flex: 1;
  font-size: 24rpx;
  color: #4a4236;
  word-break: break-all;
}

.mono {
  font-family: "DIN Alternate", monospace;
  letter-spacing: 0.5rpx;
}

.copy {
  margin-left: 12rpx;
  padding: 4rpx 12rpx;
  border: 1rpx solid #ddd2c1;
  border-radius: 4rpx;
  color: #6f675b;
  font-size: 22rpx;
}

.tl {
  padding-top: 8rpx;
}

.tl-item {
  position: relative;
  display: flex;
  padding: 12rpx 0 20rpx 28rpx;
}

.tl-item::before {
  content: "";
  position: absolute;
  left: 5rpx;
  top: 24rpx;
  bottom: -6rpx;
  width: 2rpx;
  background: #e8dece;
}

.tl-item:last-child::before {
  display: none;
}

.tl-dot {
  position: absolute;
  left: 0;
  top: 14rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #d9cebd;
}

.tl-item.latest .tl-dot {
  background: #2e4a3f;
  box-shadow: 0 0 0 5rpx #e6ede7;
}

.tl-label {
  font-size: 26rpx;
  color: #5c554a;
}

.tl-item.latest .tl-label {
  color: #26221d;
  font-weight: 600;
}

.tl-time {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #7a7264;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(247, 243, 236, 0.97);
  border-top: 1rpx solid #ebe1d2;
}

.b-btn {
  height: 84rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.b-btn + .b-btn {
  margin-left: 16rpx;
}

.b-btn.main {
  flex: 1;
}

/* 固定底栏留出滚动余量 */
.page { padding-bottom: 128rpx; }
