<view class="page order" wx:if="{{order}}">
  <view class="status {{cancelled ? 'is-off' : ''}}">
    <view class="st-row">
      <view class="st-main">
        <view class="st-text serif">{{statusText}}</view>
        <view class="st-hint">{{statusHint}}</view>
      </view>
      <view class="st-mark">{{cancelled ? '止' : '兰'}}</view>
    </view>
    <view class="progress" wx:if="{{!cancelled}}">
      <view class="p-step {{item.cls}}" wx:for="{{steps}}" wx:key="label">
        <view class="p-line {{item.lineOn ? 'on' : ''}}" wx:if="{{index < 3}}"></view>
        <view class="p-dot"></view>
        <view class="p-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="card block">
    <view class="block-head">
      <text class="bh-title serif">{{order.delivery === 'pickup' ? '到店自提' : '收货信息'}}</text>
    </view>
    <block wx:if="{{order.delivery === 'pickup'}}">
      <view class="addr-name">{{store.name}}</view>
      <view class="addr-detail">{{store.address}}</view>
      <view class="addr-sub">{{store.hours}} · 到店报订单号取货</view>
    </block>
    <block wx:else>
      <view class="addr-name">{{order.address.name}}<text class="addr-phone">{{order.address.phone}}</text></view>
      <view class="addr-detail">{{order.address.detail}}</view>
    </block>
    <view class="track" wx:if="{{trackingText}}">物流 {{trackingText}}</view>
  </view>

  <view class="card block">
    <view class="block-head">
      <text class="bh-title serif">商品</text>
      <text class="bh-sub">共 {{order.items.length}} 种</text>
    </view>
    <view class="oitem" wx:for="{{items}}" wx:key="index">
      <image class="oimg" src="{{item.image}}" mode="aspectFill" />
      <view class="obody">
        <view class="oname">{{item.name}}</view>
        <view class="ospec">{{item.color}} · {{item.size}}</view>
      </view>
      <view class="oright">
        <view class="oprice">¥{{item.priceText}}</view>
        <view class="oqty">×{{item.qty}}</view>
      </view>
    </view>
  </view>

  <view class="card block">
    <view class="srow">
      <text class="slabel">商品金额</text>
      <text class="sval">¥{{goodsText}}</text>
    </view>
    <view class="srow">
      <text class="slabel">运费</text>
      <text class="sval">{{shippingText}}</text>
    </view>
    <view class="srow" wx:if="{{discountText}}">
      <text class="slabel">积分抵扣</text>
      <text class="sval minus">{{discountText}}</text>
    </view>
    <view class="srow" wx:if="{{order.memberDiscount > 0}}">
      <text class="slabel">会员 96 折</text>
      <text class="sval minus">-¥{{order.memberDiscount}}</text>
    </view>
    <view class="hairline"></view>
    <view class="srow total">
      <text class="slabel strong">合计</text>
      <view class="price"><text class="cur">¥</text>{{amountText}}</view>
    </view>
  </view>

  <view class="card block">
    <view class="irow">
      <text class="ilabel">订单号</text>
      <text class="ival mono">{{order.no}}</text>
      <text class="copy" bindtap="copyNo">复制</text>
    </view>
    <view class="irow">
      <text class="ilabel">下单时间</text>
      <text class="ival">{{timeText}}</text>
    </view>
    <view class="irow" wx:if="{{order.remark}}">
      <text class="ilabel">备注</text>
      <text class="ival">{{order.remark}}</text>
    </view>
    <view class="irow" wx:if="{{order.cancelReason}}">
      <text class="ilabel">取消原因</text>
      <text class="ival">{{order.cancelReason}}</text>
    </view>
  </view>

  <view class="card block">
    <view class="block-head">
      <text class="bh-title serif">订单进度</text>
    </view>
    <view class="tl">
      <view class="tl-item {{item.latest ? 'latest' : ''}}" wx:for="{{timeline}}" wx:key="index">
        <view class="tl-dot"></view>
        <view class="tl-body">
          <view class="tl-label">{{item.label}}</view>
          <view class="tl-time">{{item.timeText}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="bar">
    <block wx:if="{{order.status === 'pending_pay'}}">
      <view class="btn ghost b-btn" bindtap="cancel">取消订单</view>
      <view class="btn primary b-btn main" bindtap="goPay">去支付</view>
    </block>
    <block wx:elif="{{order.status === 'paid'}}">
      <view class="btn ghost b-btn" bindtap="contact">联系店长</view>
      <view class="btn primary b-btn main" bindtap="goShop">继续逛逛</view>
    </block>
    <block wx:elif="{{order.status === 'shipped'}}">
      <view class="btn ghost b-btn" bindtap="callStore">打电话</view>
      <view class="btn primary b-btn main" bindtap="confirmReceive">确认收货</view>
    </block>
    <block wx:elif="{{order.status === 'return_pending'}}">
      <view class="btn ghost b-btn" bindtap="contact">联系店长</view>
      <view class="btn ghost b-btn main" bindtap="goShop">继续逛逛</view>
    </block>
    <block wx:elif="{{order.status === 'done'}}">
      <view class="btn ghost b-btn" bindtap="applyReturn">申请退货</view>
      <view class="btn primary b-btn main" bindtap="goShop">再来一单</view>
    </block>
    <block wx:else>
      <view class="btn ghost b-btn" bindtap="contact">联系店长</view>
      <view class="btn primary b-btn main" bindtap="goShop">再来一单</view>
    </block>
  </view>
</view>
