<view class="page addr">
  <view class="tip" wx:if="{{selectMode}}">点一条地址，回结算页就用它。</view>

  <view class="list">
    <view class="item" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="pick">
      <view class="it-top">
        <text class="it-name">{{item.name}}</text>
        <text class="it-phone">{{item.phone}}</text>
        <text class="it-badge" wx:if="{{item.isDefault}}">默认</text>
        <text class="it-tag" wx:if="{{item.tag}}">{{item.tag}}</text>
      </view>
      <view class="it-detail">{{item.detail}}</view>
      <view class="it-ops">
        <text class="op" wx:if="{{!item.isDefault}}" data-id="{{item.id}}" catchtap="setDefault">设为默认</text>
        <text class="op" data-id="{{item.id}}" catchtap="edit">编辑</text>
        <text class="op danger" data-id="{{item.id}}" catchtap="del">删除</text>
      </view>
    </view>

    <view class="empty" wx:if="{{!list.length && !loading}}">
      <view class="empty-text">还没有收货地址</view>
      <view class="empty-sub">送快递的话填一个，下次下单就不用再打字了</view>
    </view>
  </view>

  <view class="foot">
    <button class="btn btn-ghost" bindtap="fromWx">用微信里的地址</button>
    <button class="btn btn-primary" bindtap="add">新增地址</button>
  </view>

  <view class="mask" wx:if="{{formOpen}}" bindtap="closeForm"></view>
  <view class="sheet" wx:if="{{formOpen}}">
    <view class="sheet-bar"></view>
    <view class="sheet-title serif">{{form.id ? '改地址' : '新地址'}}</view>

    <view class="field">
      <text class="field-label">收货人</text>
      <input value="{{form.name}}" data-field="name" bindinput="onInput" placeholder="家长姓名" placeholder-class="ph" maxlength="20" />
    </view>
    <view class="field">
      <text class="field-label">手机号</text>
      <input value="{{form.phone}}" data-field="phone" type="number" maxlength="11" bindinput="onInput" placeholder="11 位手机号" placeholder-class="ph" />
    </view>
    <view class="field">
      <text class="field-label">地址</text>
      <input value="{{form.detail}}" data-field="detail" bindinput="onInput" placeholder="小区 / 街道 / 门牌号" placeholder-class="ph" maxlength="120" />
    </view>
    <view class="field no-line">
      <text class="field-label">标签</text>
      <input value="{{form.tag}}" data-field="tag" bindinput="onInput" placeholder="家 / 学校 / 公司（可不填）" placeholder-class="ph" maxlength="6" />
    </view>

    <view class="def-row">
      <text class="def-label">设为默认地址</text>
      <switch checked="{{form.isDefault}}" color="#2E4A3F" bindchange="onDefault" />
    </view>

    <view class="err" wx:if="{{formError}}">{{formError}}</view>

    <view class="sheet-foot">
      <button class="btn btn-ghost" bindtap="closeForm">取消</button>
      <button class="btn btn-primary" disabled="{{saving}}" bindtap="save">{{saving ? '保存中…' : '保存'}}</button>
    </view>
  </view>
</view>
