<view class="page detail" wx:if="{{p}}">
  <view class="gallery">
    <image class="cover" src="{{p.image}}" mode="aspectFill" bindtap="preview" />
    <view class="gallery-tags">
      <text class="gtag" wx:for="{{p.tags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="main-card">
    <view class="price-row">
      <view class="price main-price"><text class="cur">¥</text>{{p.price}}</view>
      <text class="price-old">¥{{p.originalPrice}}</text>
      <view class="grow"></view>
      <view class="sold">已售 {{p.sales}}</view>
    </view>
    <view class="pname serif">{{p.name}}</view>
    <view class="psub">{{p.school}} · {{p.stage}} · {{p.category}}</view>
    <view class="points-tip" bindtap="goPoints">
      <text class="pt-key">积分</text>
      <text class="pt-val">可用 {{canUse}} 元 · 每单最多抵 5%</text>
      <text class="pt-arrow">›</text>
    </view>
  </view>

  <view class="card block">
    <view class="opt">
      <view class="opt-head">
        <text class="opt-label">颜色</text>
        <text class="opt-value">{{p.colors[colorIndex].name}}</text>
      </view>
      <view class="dots">
        <view
          class="dot-wrap {{index === colorIndex ? 'on' : ''}}"
          wx:for="{{p.colors}}"
          wx:key="name"
          data-i="{{index}}"
          bindtap="pickColor"
        >
          <view class="dot" style="background: {{item.value}};"></view>
        </view>
      </view>
    </view>

    <view class="hairline"></view>

    <view class="opt">
      <view class="opt-head">
        <text class="opt-label">尺码</text>
        <text class="opt-value" wx:if="{{sizeIndex >= 0}}">{{p.sizes[sizeIndex]}}</text>
        <text class="opt-value muted" wx:else>还没选</text>
        <view class="grow"></view>
        <view class="size-help" bindtap="openSize">尺码参考 ›</view>
      </view>
      <view class="sizes">
        <view
          class="size-chip {{index === sizeIndex ? 'on' : ''}}"
          wx:for="{{p.sizes}}"
          wx:key="*this"
          data-i="{{index}}"
          bindtap="pickSize"
        >{{item}}</view>
      </view>
    </view>

    <view class="hairline"></view>

    <view class="qty-row">
      <text class="opt-label">数量</text>
      <view class="grow"></view>
      <view class="stepper">
        <view class="step {{qty <= 1 ? 'off' : ''}}" bindtap="minus">−</view>
        <view class="step-num">{{qty}}</view>
        <view class="step" bindtap="plus">＋</view>
      </view>
    </view>
  </view>

  <view class="card block">
    <view class="svc"><text class="svc-check">✓</text><text>校服同款版型，按学校分版</text></view>
    <view class="svc"><text class="svc-check">✓</text><text>到店可试穿，7 天无理由退换</text></view>
    <view class="svc"><text class="svc-check">✓</text><text>快递 ¥8 起，满 ¥50 包邮；也可到店自提</text></view>
    <view class="svc"><text class="svc-check">✓</text><text>微信支付，付完当天安排发货</text></view>
  </view>

  <view class="card block">
    <view class="block-title serif">细节与面料</view>
    <view class="kv">
      <text class="k">面料</text>
      <text class="v">{{p.fabric}}</text>
    </view>
    <view class="kv">
      <text class="k">说明</text>
      <text class="v">{{p.desc}}</text>
    </view>
    <view class="kv">
      <text class="k">选码</text>
      <text class="v">{{p.sizeTip}}</text>
    </view>
  </view>

  <view class="related" wx:if="{{related.length}}">
    <view class="rel-head">
      <text class="sec-title">同校再看看</text>
      <text class="sec-sub">同一版型，尺码互通</text>
    </view>
    <view class="rel-grid">
      <view class="rel-item" wx:for="{{related}}" wx:key="id">
        <product-card item="{{item}}" />
      </view>
    </view>
  </view>

  <view class="bar">
    <view class="bar-side" bindtap="goCart">
      <text class="bar-side-text">购物车</text>
      <view class="bar-badge" wx:if="{{cartCount}}">{{cartCount}}</view>
    </view>
    <view class="bar-side" bindtap="contact">
      <text class="bar-side-text">问店长</text>
    </view>
    <view class="bar-main">
      <view class="btn bar-btn bar-cart" bindtap="addCart">加入购物车</view>
      <view class="btn bar-btn bar-buy" bindtap="buyNow">立即购买</view>
    </view>
  </view>
</view>

<view class="mask" wx:if="{{sizeOpen}}" bindtap="closeSize"></view>
<view class="sheet" wx:if="{{sizeOpen}}">
  <view class="sheet-grip"></view>
  <view class="between">
    <view>
      <view class="sheet-title">尺码参考</view>
      <view class="sheet-sub">尺码就是身高，填一下孩子多高就行</view>
    </view>
    <view class="sheet-close" bindtap="closeSize">×</view>
  </view>

  <view class="fit">
    <view class="fit-head">
      <text class="fit-title">报个身高，直接对上码</text>
      <text class="fit-sub">尺码就是身高：170 码给 168–172cm 的同学穿</text>
    </view>
    <view class="fit-fields">
      <view class="fit-field">
        <input
          class="fit-input"
          type="number"
          value="{{fitH}}"
          data-field="h"
          bindinput="onFitInput"
          placeholder="孩子身高"
          placeholder-class="fit-ph"
        />
        <text class="fit-unit">cm</text>
      </view>
      <view class="fit-go" bindtap="doFit">找尺码</view>
    </view>
    <view class="fit-error" wx:if="{{fitError}}">{{fitError}}</view>
    <view class="fit-result" wx:if="{{fitResult}}">
      <view class="fit-line">
        <text class="fit-badge">{{fitResult.size}} 码</text>
        <view class="grow"></view>
        <view class="fit-apply" bindtap="applyFit">就用它</view>
      </view>
      <text class="fit-note">{{fitResult.note}}</text>
    </view>
  </view>

  <view class="guide-tabs">
    <view class="gt {{guideTab === 'kid' ? 'on' : ''}}" data-tab="kid" bindtap="switchGuide">小学 110–160</view>
    <view class="gt {{guideTab === 'adult' ? 'on' : ''}}" data-tab="adult" bindtap="switchGuide">中学 150–200</view>
  </view>

  <view class="table">
    <view class="tr th">
      <text class="td">尺码</text>
      <text class="td">适合身高 cm</text>
      <text class="td wide">说明</text>
    </view>
    <view class="tr" wx:for="{{guide[guideTab]}}" wx:key="size">
      <text class="td">{{item.size}}</text>
      <text class="td">{{item.height}}</text>
      <text class="td wide">{{item.note}}</text>
    </view>
  </view>

  <view class="sheet-tip">{{p.sizeTip}}</view>
  <view class="btn btn-primary sheet-btn" bindtap="closeSize">知道了</view>
</view>
