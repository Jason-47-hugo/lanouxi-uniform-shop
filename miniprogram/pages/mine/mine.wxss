.mine {
  padding-bottom: 48rpx;
}

.top {
  padding: 8rpx 32rpx 0;
}

.brand-row {
  display: flex;
  align-items: baseline;
  padding: 8rpx 8rpx 24rpx;
}

.brand {
  font-size: 42rpx;
  letter-spacing: 8rpx;
  color: #26221d;
}

.brand-sub {
  margin-left: 16rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: #7a7264;
}

.member {
  position: relative;
  display: flex;
  align-items: center;
  padding: 32rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #33513f 0%, #24382f 100%);
  overflow: hidden;
}

.member::after {
  content: "";
  position: absolute;
  right: -60rpx;
  top: -80rpx;
  width: 260rpx;
  height: 260rpx;
  border: 1rpx solid rgba(248, 244, 236, 0.12);
  border-radius: 50%;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 96rpx;
  margin-right: 24rpx;
  border: 1rpx solid rgba(248, 244, 236, 0.45);
  border-radius: 50%;
  background: rgba(248, 244, 236, 0.1);
  color: #f0d68a;
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 42rpx;
  line-height: 96rpx;
  text-align: center;
}

.member-main {
  flex: 1;
}

.member-name {
  font-size: 30rpx;
  color: #f8f4ec;
  letter-spacing: 1rpx;
}

.member-tag {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(248, 244, 236, 0.6);
}

.pts {
  position: relative;
  z-index: 1;
  text-align: right;
  padding-left: 20rpx;
}

.pts-num {
  font-family: "DIN Alternate", "Helvetica Neue", sans-serif;
  font-size: 46rpx;
  font-weight: 700;
  color: #f0d68a;
  /* 数字字形比 font-size 高一点，行高写 1 会被裁掉下半截（审计脚本报 H pts-num 28>23） */
  line-height: 1.2;
}

.pts-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(248, 244, 236, 0.55);
}

.block {
  margin: 20rpx 32rpx 0;
  padding: 28rpx 32rpx 24rpx;
}

.block-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.bh {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.more {
  font-size: 24rpx;
  color: #736b5e;
}

.ostat-row {
  display: flex;
  margin-top: 24rpx;
}

.ostat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.oico {
  position: relative;
  width: 78rpx;
  height: 78rpx;
  border: 1rpx solid #e8dece;
  border-radius: 50%;
  background: #faf6ee;
  color: #2e4a3f;
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 32rpx;
  line-height: 78rpx;
  text-align: center;
}

.badge {
  position: absolute;
  top: -6rpx;
  right: -8rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #b65b3c;
  color: #fff8ee;
  font-family: "DIN Alternate", sans-serif;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: center;
}

.olabel {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6f675b;
}

.pcard {
  margin: 20rpx 32rpx 0;
  padding: 28rpx 32rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #2b3d51 0%, #212f40 100%);
  overflow: hidden;
}

.pc-top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.pc-label {
  font-size: 24rpx;
  letter-spacing: 3rpx;
  color: rgba(248, 244, 236, 0.55);
}

.pc-num {
  margin-top: 8rpx;
  font-family: "DIN Alternate", sans-serif;
  font-size: 56rpx;
  font-weight: 700;
  color: #f8f4ec;
  line-height: 1.2;
}

.pc-side {
  text-align: right;
}

.pc-side-k {
  font-size: 22rpx;
  color: rgba(248, 244, 236, 0.45);
}

.pc-side-v {
  margin-top: 4rpx;
  font-size: 28rpx;
  color: #f0d68a;
  font-weight: 600;
}

.pc-bar {
  height: 6rpx;
  margin-top: 24rpx;
  border-radius: 4rpx;
  background: rgba(248, 244, 236, 0.14);
  overflow: hidden;
}

.pc-fill {
  height: 100%;
  border-radius: 4rpx;
  background: #f0d68a;
}

.pc-sub {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: rgba(248, 244, 236, 0.5);
}

.menu {
  padding: 4rpx 32rpx;
}

.mrow {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f4ecde;
}

.mrow:last-child {
  border-bottom: 0;
}

.mkey {
  font-size: 28rpx;
  color: #26221d;
}

.mval {
  flex: 1;
  text-align: right;
  margin-right: 8rpx;
  font-size: 24rpx;
  color: #7a7264;
}

.arrow {
  font-size: 32rpx;
  color: #c8bda9;
  line-height: 1;
}

.footer {
  padding: 56rpx 0 20rpx;
  text-align: center;
}

.footer-line {
  width: 60rpx;
  height: 2rpx;
  margin: 0 auto 20rpx;
  background: #d9cebd;
}

.footer-text {
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: #6f675b;
}

.footer-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #84796a;
}
